{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-taste",
  "main": "src/index.js",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "home-taste-prod",
      "database_id": "e6bc4109-68c0-483c-9fcb-b5b9420391f9"
    }
  ]
}
